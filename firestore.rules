rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Loki Cloud Vault Security Rules
    // Protects users, clients, platforms, override requests, and audit logs
    match /users/{userId} {
      allow read, write: if true;
    }

    match /clients/{clientId} {
      allow read, write: if true;

      match /platforms/{platformId} {
        allow read, write: if true;
      }
    }

    match /override_requests/{reqId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
