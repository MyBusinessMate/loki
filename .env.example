# ==============================================================================
# LOKI AGENCY VAULT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development or configure in Vercel project settings:
# https://vercel.com/docs/projects/environment-variables
# NOTE: Never commit sensitive credentials or service-account private keys to Git.

# --- SERVER / API CONFIGURATION ---
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# --- JWT AUTHENTICATION ---
# Secure random string (minimum 256 bits / 32 characters) used for signing session tokens
# In production, this MUST be configured; in development/testing, an ephemeral 256-bit key is generated.
JWT_SECRET=your_jwt_signing_secret_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- AUDIT LOGGING ---
# Secret key used for cryptographic HMAC audit chain verification
AUDIT_HMAC_SECRET=your_audit_hmac_secret_here_min_16_characters

# --- FIREBASE CLIENT (PUBLIC CONFIG - VERCEL & LOCAL) ---
# Set these in your Vercel Project Environment Variables (Production & Preview)
# and in your local .env file.
# Replace with your Firebase Web App configuration from Firebase Console:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project_id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# --- FIREBASE ADMIN / SERVICE ACCOUNT (SERVER ONLY) ---
# Optional: Required ONLY if running server-side elevated administration operations.
# NEVER prefix with VITE_ or expose to frontend bundles.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
