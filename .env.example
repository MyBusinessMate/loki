# ==============================================================================
# LOKI AGENCY VAULT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local or non-MCP development.
# NOTE: Never commit sensitive credentials or service-account private keys to Git.

# --- SERVER / API CONFIGURATION ---
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# --- JWT AUTHENTICATION ---
# Secure random string (minimum 256 bits) used for signing session tokens
JWT_SECRET=your_jwt_signing_secret_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- FIREBASE CLIENT (PUBLIC CONFIG) ---
# Used by frontend client SDK. Safe for browser usage with Firestore Security Rules.
VITE_FIREBASE_API_KEY=AIzaSyBAjlZjAx_W41O7t-putJk5X_0od-wfXww
VITE_FIREBASE_AUTH_DOMAIN=loki-agency-vault.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=loki-agency-vault
VITE_FIREBASE_STORAGE_BUCKET=loki-agency-vault.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=362141834407
VITE_FIREBASE_APP_ID=1:362141834407:web:fcccca568b840ac0a68f82

# --- FIREBASE ADMIN / SERVICE ACCOUNT (SERVER ONLY) ---
# Required ONLY for server-side elevated administration operations.
# NEVER expose these to frontend bundles or commit to version control.
FIREBASE_PROJECT_ID=loki-agency-vault
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@loki-agency-vault.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"
